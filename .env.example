# Supabase connection.
#
# Copy this file to `.env.local` and fill in the values from your Supabase
# project (Project Settings -> API). These two values ship in the browser
# bundle and are safe to expose: the anon key is protected by Row Level
# Security.
#
# Never put the `service_role` key here. It bypasses RLS and is used only
# inside Edge Functions, where it stays server-side.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
